                        C.CONTACT_NM, 
                        C.PHONE_NO, 
                        C.COMPANY_NM, 
                        M.GROUP_ID,
                        C.REG_DT
                    FROM TB_CONTACT C
                    INNER JOIN TB_GROUP_CONTACT_MAP M ON C.CONTACT_ID = M.CONTACT_ID
                    WHERE M.GROUP_ID = '175'
                    ORDER BY C.CONTACT_ID DESC
                ) X

            ) A WHERE ROWNUM  <=  0 + 10
        ) WHERE RNUM > 0

