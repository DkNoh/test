                AND A.REQ_DT <= TO_DATE('2026-05-30' || ' 23:59:59', 'YYYY-MM-DD HH24:MI:SS') 

        ORDER BY A.REQ_DT DESC
        OFFSET 0 ROWS FETCH NEXT 10 ROWS ONLY

