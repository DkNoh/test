document.addEventListener('DOMContentLoaded', function () {
    CommonUtils.setDefaultDateTime();  // 기본값 세팅

    let currentPage = 1;
    let currentSize = 10;

    // ── Grid 초기화 ───────────────────────────────────────
    const grid = new tui.Grid({
        el: document.getElementById('grid'),
        data: [],
        ...TuiCommon.gridDefaults,
        columns: [
            {
                header: '발송일시', name: 'sentAt', width: 148, align: 'center', sortable: true,
                formatter: ({ value }) => TuiCommon.fmt.date(value)
            },
            { header: '수신번호', name: 'receiverNo', width: 120, align: 'center' },
            { header: '발신번호', name: 'senderNo', width: 120, align: 'center' },
            {
                header: '메시지내용', name: 'message', minWidth: 220,
                formatter: ({ value }) => value || '-'
            },
            {
                header: '발송상태', name: 'sendStatus', width: 88, align: 'center', sortable: true,
                formatter: TuiCommon.fmt.sendStatus
            },
            {
                header: '발송유형', name: 'sendType', width: 88, align: 'center',
                formatter: TuiCommon.fmt.sendType
            },
            {
                header: '재발송', name: 'resendYn', width: 72, align: 'center',
                formatter: TuiCommon.fmt.resendYn
            },
        ],
    });

    // ── 행 클릭 → 상세 모달 ──────────────────────────────
    grid.on('click', ({ rowKey }) => {
        if (rowKey == null) return;
        const row = grid.getRow(rowKey);
        if (row?.id) CommonUtils.openDetail(
            `${SERVER_DATA.detailUrl}/${row.id}`, fillDetail
        );
    });

    function loadData() {
        const startDate = document.querySelector('#startDate').value;
        const startTime = document.querySelector('#startTime').value || '00:00';
        const endDate   = document.querySelector('#endDate').value;
        const endTime   = document.querySelector('#endTime').value || '23:59';

        const requestBody = {
            page: currentPage,
            size: currentSize,
            startDate: startDate,
            endDate: endDate,
            receiverNo: document.querySelector('#receiverNo').value.trim(),
            sendType: document.querySelector('#sendType').value,
        };

        axios.post(`${SERVER_DATA.apiUrl}/search`, requestBody)
            .then(response => {
                grid.resetData(response.data.contents || []);
                TuiCommon.updateTotalCount(response.data.totalCount || 0);
                TuiCommon.renderPagination(response.data.page || 1, response.data.totalPages || 1, movePage);
            })
            .catch(error => {
                grid.resetData([]);
                TuiCommon.updateTotalCount(0);
                TuiCommon.renderPagination(1, 1, movePage);
            });
    }

    function movePage(page) { currentPage = page; loadData(); }

    // ── 상세 모달 데이터 채우기 ───────────────────────────
    function fillDetail(d) {
        const status = { SUCCESS: '성공', FAIL: '실패', WAIT: '대기' };
        const type = { SMS: 'SMS', LMS: 'LMS', ALIMTALK: '알림톡' };

        document.querySelector('#d-sendType').textContent = type[d.sendType] || d.sendType || '-';
        document.querySelector('#d-senderNo').textContent = d.senderNo || '-';
        document.querySelector('#d-receiverNo').textContent = d.receiverNo || '-';
        document.querySelector('#d-sendStatus').textContent = status[d.sendStatus] || d.sendStatus || '-';
        document.querySelector('#d-resendYn').textContent = d.resendYn === 'Y' ? '재발송' : '최초발송';
        document.querySelector('#d-resultCode').textContent = d.resultCode || '-';
        document.querySelector('#d-resultMessage').textContent = d.resultMessage || '-';
        document.querySelector('#d-sentAt').textContent = TuiCommon.fmt.date(d.sentAt);
        document.querySelector('#d-reservedAt').textContent = TuiCommon.fmt.date(d.reservedAt);
        document.querySelector('#d-message').textContent = d.message || '-';
    }

    // ── 이벤트 바인딩 ─────────────────────────────────────
    document.querySelector('#btn-search')
        .addEventListener('click', () => { currentPage = 1; loadData(); });

    document.querySelector('#btn-reset')
        .addEventListener('click', () => { CommonUtils.resetFields(); currentPage = 1; loadData(); });

    document.querySelector('#btn-excel-export-tui')
        ?.addEventListener('click', () => { TuiCommon.exportExcel(grid, 'sms_history_tui_export'); });

    document.querySelector('#btn-excel-export-poi')
        ?.addEventListener('click', () => {
            const requestBody = CommonUtils.getSearchParams();
            
            axios.post(`${SERVER_DATA.apiUrl}/excel`, requestBody, { responseType: 'blob' })
                .then(response => {
                    const url = window.URL.createObjectURL(new Blob([response.data]));
                    const link = document.createElement('a');
                    link.href = url;
                    link.setAttribute('download', 'sms_history_export.xlsx');
                    document.body.appendChild(link);
                    link.click();
                    link.parentNode.removeChild(link);
                })
                .catch(error => {
                    CommonUtils.alert('엑셀 다운로드 중 오류가 발생했습니다.', '오류');
                    console.error(error);
                });
        });

    document.querySelector('#pageSizeSelect')
        .addEventListener('change', e => { currentSize = +e.target.value; currentPage = 1; loadData(); });

    document.querySelector('#receiverNo')
        .addEventListener('keydown', e => { if (e.key === 'Enter') { currentPage = 1; loadData(); } });

    // ── 최초 로드 ─────────────────────────────────────────
    //loadData();
});
