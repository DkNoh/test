<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.sms.mapper.CommonCodeMapper">
    <select id="selectActiveDepartments" resultType="com.example.sms.vo.common.CommonCodeVO">
        SELECT 
            DEP_ID as code, 
            DEP_NM as name 
        FROM DEP 
        WHERE ACT_YN = 'Y' 
        ORDER BY DEP_NM ASC
    </select>
</mapper>
