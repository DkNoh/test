# Local development environment sample
# Copy values into your shell/profile or local runner configuration.

# local: personal PC with scaffold enabled
# dev: development server without scaffold
# prod: production server
SPRING_PROFILES_ACTIVE=dev

LDAP_URL=ldap://your.ldap.server:389
LDAP_BASE_DN=ou=users,dc=example,dc=com

APP_UPLOAD_DIR=C:/Work/upload

DEV_DATASOURCE_URL=jdbc:log4jdbc:oracle:thin:@localhost:1521/SMS
DEV_DATASOURCE_USERNAME=system
DEV_DATASOURCE_PASSWORD=1234
DEV_DATASOURCE_DRIVER=net.sf.log4jdbc.sql.jdbcapi.DriverSpy
DEV_DATASOURCE_MAX_POOL_SIZE=10
DEV_DATASOURCE_MIN_IDLE=5
DEV_DATASOURCE_CONNECTION_TIMEOUT=30000

LOCAL_DATASOURCE_URL=jdbc:log4jdbc:oracle:thin:@localhost:1521/SMS
LOCAL_DATASOURCE_USERNAME=system
LOCAL_DATASOURCE_PASSWORD=1234
LOCAL_DATASOURCE_DRIVER=net.sf.log4jdbc.sql.jdbcapi.DriverSpy
LOCAL_DATASOURCE_MAX_POOL_SIZE=10
LOCAL_DATASOURCE_MIN_IDLE=5
LOCAL_DATASOURCE_CONNECTION_TIMEOUT=30000

PROD_DATASOURCE_JNDI_NAME=java:/comp/env/jdbc/SMS
